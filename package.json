{
  "name": "harnesside",
  "version": "0.3.1",
  "description": "Local llama.cpp coding agent: a daemon that drives a CDP-launched browser IDE (OpenAI-compatible, self-healing, memory-compaction with auto-resume)",
  "repository": "https://github.com/jeano76/harnesside",
  "license": "MIT",
  "type": "module",
  "bin": {
    "harnesside": "./dist/server/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web && node scripts/pack-web-assets.mjs && npm run build:info",
    "build:info": "node scripts/gen-build-info.mjs",
    "release": "node scripts/gen-build-info.mjs && node scripts/make-release.mjs --require-clean",
    "install:g": "npm run build && npm install -g . && node scripts/install-global.mjs",
    "release:repro": "node scripts/make-release.mjs --verify-repro",
    "verify:selfupdate": "tsx scripts/verify-selfupdate.mjs",
    "prepublishOnly": "npm run build",
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
    "start": "node dist/server/index.js",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/verify-window.mjs && node scripts/verify-terminal.mjs",
    "typecheck": "tsc --noEmit",
    "rename:check": "node scripts/rename-identifiers.mjs --dry",
    "coverage": "node scripts/coverage-floor.mjs",
    "coverage:report": "node scripts/coverage-floor.mjs --report"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "marked": "^15.0.12",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "string-width": "^5.1.2",
    "strip-ansi": "^7.2.0",
    "ws": "^8.21.3",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "ink": "^4.4.1",
    "marked-terminal": "^7.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "optionalDependencies": {
    "monaco-editor": "^0.52.0"
  },
  "engines": {
    "node": ">=22"
  }
}
